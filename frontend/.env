# ─── Frontend Environment Variables ─────────────────────────────
# 
# VITE_API_URL:
#   - اتركه فارغ للوكال (يستخدم Vite Proxy → localhost:5000)
#   - ضع رابط الـ ngrok أو الباكنند الخارجي للمشاركة مع العميل
#
# مثال لوكال (افتراضي):
# VITE_API_URL=
#
# مثال عند استخدام ngrok للباكنند:
# VITE_API_URL=https://YOUR-BACKEND.ngrok-free.dev/api
#
# ─────────────────────────────────────────────────────────────────

VITE_API_URL=
